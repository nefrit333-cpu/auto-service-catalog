---
import { ArrowRight, CalendarPlus, Clock } from '@lucide/astro'
import { formatPrice, serviceCategories } from '../data/services'
import type { Service } from '../types'
import { withBase } from '../utils/paths'

interface Props {
  readonly service: Service
}

const { service } = Astro.props
const categoryLabel =
  serviceCategories.find((category) => category.id === service.category)?.label ?? 'Услуга'
---

<article class="service-card" data-service-card data-category={service.category}>
  <div class="card-topline">
    <span class="category-badge">{categoryLabel}</span>
    <span class="duration">
      <Clock size={16} aria-hidden="true" />
      {service.duration}
    </span>
  </div>
  <h3>{service.title}</h3>
  <p>{service.shortDescription}</p>
  <div class="service-card-footer">
    <strong>от {formatPrice(service.priceFrom)} ₽</strong>
    <div class="service-actions">
      <a class="text-link" href={withBase(`services/${service.slug}/`)}>
        Подробнее
        <ArrowRight size={16} aria-hidden="true" />
      </a>
      <button class="button button-small" type="button" data-booking-open data-service-id={service.id}>
        <CalendarPlus size={16} aria-hidden="true" />
        Записаться
      </button>
    </div>
  </div>
</article>
